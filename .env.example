# Supabase
# For a self-hosted Supabase on your local network, set SUPABASE_URL to the
# server-reachable address (e.g. http://192.168.1.50:8001). SUPABASE_URL is
# server-only and is preferred over NEXT_PUBLIC_SUPABASE_URL, so the local
# address is never shipped to the browser. NEXT_PUBLIC_SUPABASE_URL is optional
# and only needed if you later add browser-side Supabase calls.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# APP_BASE_URL must be the public Cloudflare tunnel URL so Recall.ai can reach
# the webhook. The app listens on port 8002 (npm run dev / npm run start).
APP_BASE_URL=https://your-tunnel-hostname
CRON_SECRET=
DEV_USER_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-tunnel-hostname/api/auth/google/callback

# Recall.ai
RECALLAI_API_KEY=
RECALLAI_REGION=us-east-1
RECALLAI_WORKSPACE_VERIFICATION_SECRET=
RECALLAI_BOT_NAME=Meeting Recorder

# Summarization
SUMMARY_PROVIDER=openai
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-4.1-mini
