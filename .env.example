# Supabase
# For a self-hosted Supabase on your local network, set SUPABASE_URL to the
# server-reachable address (e.g. http://192.168.1.50:8001). On Docker/Hostinger,
# use the internal Kong hostname (e.g. http://kong:8000) — see .env.hostinger.example.
# SUPABASE_URL is server-only and is preferred over NEXT_PUBLIC_SUPABASE_URL.
# IMPORTANT: SUPABASE_URL, the anon key, and the service role key must all point
# to the SAME Supabase project (the one that holds your auth users + data).
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Required for login/session middleware even though auth runs server-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
# APP_BASE_URL must be the public HTTPS URL (include https://) so Recall.ai and
# Google OAuth can reach webhooks and callbacks. The app listens on port 8002.
APP_BASE_URL=https://your-domain.example.com
CRON_SECRET=
DEV_USER_ID=

# Auth: only these emails may sign in (comma-separated). Leave empty to allow
# any authenticated Supabase user. Also disable signups in Supabase so no new
# accounts can be created.
ALLOWED_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-tunnel-hostname/api/auth/google/callback

# Recall.ai
RECALLAI_API_KEY=
RECALLAI_REGION=us-east-1
RECALLAI_WORKSPACE_VERIFICATION_SECRET=
RECALLAI_BOT_NAME=Meeting Recorder

# Summarization (Bunsen)
SUMMARY_PROVIDER=openai
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-4.1-mini
RESEARCH_MODEL=gpt-4.1
BUNSEN_MAX_RESEARCH_TOPICS=5
BUNSEN_MAX_KEYFRAMES=12

# Beaker (vector DB + MCP)
EMBEDDING_MODEL=text-embedding-3-small
MCP_ACCESS_TOKEN=
